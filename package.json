{
  "name": "vku-field-survey-pwa",
  "version": "1.0.0",
  "description": "VKU Field Survey - Offline Data Collection PWA & Capacitor (Mini-Project 1)",
  "main": "app.js",
  "scripts": {
    "start": "npx serve .",
    "deploy": "wrangler pages deploy . --project-name vku-field-survey",
    "cap:init": "npx cap init \"VKU Field Survey\" \"vn.udn.vku.fieldsurvey\" --web-dir .",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/network": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "wrangler": "^4.129.0"
  },
  "keywords": ["vku", "pwa", "offline-first", "indexeddb", "service-worker", "capacitor"],
  "author": "VKU Student",
  "license": "MIT"
}
